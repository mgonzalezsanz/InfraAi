{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OidcSafetyPolicy",
      "Effect": "Deny",
      "Action": "sts:AssumeRole",
      "Resource": "*"
    },
    {
      "Sid": "ScopedMutatingAccess",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:PutBucketVersioning",
        "s3:PutBucketTagging",
        "s3:PutLifecycleConfiguration",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::<RESOURCE_NAME_PREFIX>-*",
        "arn:aws:s3:::<RESOURCE_NAME_PREFIX>-*/*"
      ]
    },
    {
      "Sid": "ReadOnlyForPlanning",
      "Effect": "Allow",
      "Action": ["s3:Describe*", "s3:Get*", "s3:List*"],
      "Resource": "*"
    },
    {
      "Sid": "TerraformStateBackend",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::<STATE_BUCKET>/<STATE_KEY_PREFIX>/*"
    }
  ]
}
